      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst b = item.body || item;\nconst rec = (b && b.record) || {};\nconst CAT_FIELDS = {\n  customers: ['name','phone','email','address'],\n  vehicles: ['plate','make','model','year','color','customer'],\n  quotations: ['quoteNo','customer','plate','status','validUntil','items','total'],\n  jobOrders: ['jobNo','customer','plate','priority','status','mechanic','department','services'],\n  invoices: ['invoiceNo','jobNo','customer','plate','vehicle','items','amount','status'],\n  inventory: ['name','category','sku','qty','unit','cost','sell','reorderLevel'],\n  reminders: ['customer','phone','plate','dueDate','lastService','status'],\n};\nif (!CAT_FIELDS[b.cat] || !rec.id) throw new Error('bad request: unknown cat or missing record id');\nconst row = { cat: b.cat, 'Date/Time': String(rec.timestamp || ''), ID: String(rec.id), deleted: String(rec.deleted || '') };\nfor (const f of CAT_FIELDS[b.cat]) row[f] = rec[f] == null ? '' : String(rec[f]);\nreturn [{ json: row }];"
      },
