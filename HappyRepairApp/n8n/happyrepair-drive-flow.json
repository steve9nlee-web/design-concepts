    {
      "parameters": {
        "jsCode": "const low = $input.all().filter(i => i.json.name && Number(i.json.qty || 0) <= Number(i.json.reorderLevel || 0));\nif (!low.length) return [];\nconst lines = low.map(i => `- ${i.json.name} (SKU ${i.json.sku || '-'}): ${i.json.qty} ${i.json.unit || ''} left, reorder at ${i.json.reorderLevel}`);\nreturn [{ json: { count: low.length, body: lines.join('\\n') } }];"
      },
      "id": "e5000000-0000-0000-0000-000000000001",
      "name": "Find low stock",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 580]
    },
    {
      "parameters": {
        "sendTo": "REPLACE_WITH_YOUR_EMAIL",
        "subject": "=Low stock alert: {{ $json.count }} item(s) need reordering",
        "emailType": "text",
        "message": "=These inventory items are at or below their reorder level:\n\n{{ $json.body }}\n\n(From the latest HappyRepairApp export on Google Drive)",
        "options": {}
      },
      "id": "f6000000-0000-0000-0000-000000000001",
      "name": "Email low-stock alert",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [680, 580]
    },
    {
      "parameters": {
        "jsCode": "const soon = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000);\nconst due = $input.all().filter(i => {\n  if (!i.json.customer) return false;\n  const d = new Date(i.json.dueDate);\n  return !isNaN(d.getTime()) && d <= soon;\n});\nif (!due.length) return [];\nconst lines = due.map(i => `- ${i.json.customer} (${i.json.plate || '-'}, ${i.json.phone || 'no phone'}): service due ${i.json.dueDate}`);\nreturn [{ json: { count: due.length, body: lines.join('\\n') } }];"
      },
      "id": "e5000000-0000-0000-0000-000000000002",
      "name": "Find services due soon",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 720]
    },
