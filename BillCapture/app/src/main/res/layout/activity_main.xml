<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="20dp"
    android:background="@color/white">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bill Capture App"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/btn_upload_scan"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="@string/upload_photo_auto_scan"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"
        android:backgroundTint="#6a1fa8" />

    <Button
        android:id="@+id/btn_select_cloud"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Select Google Drive Account"
        android:textSize="16sp"
        android:layout_marginBottom="20dp"
        android:backgroundTint="#4285F4" />

    <Button
        android:id="@+id/btn_start_capture"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Capture Bill"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"
        android:backgroundTint="#1f7a1f" />

    <Button
        android:id="@+id/btn_manual_upload"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="@string/upload_photo_manual"
        android:textSize="16sp"
        android:layout_marginBottom="20dp"
        android:backgroundTint="#b06f00" />

    <Button
        android:id="@+id/btn_view_history"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="View Bill History"
        android:textSize="16sp"
        android:layout_marginBottom="20dp"
        android:backgroundTint="#ff9800" />

</LinearLayout>